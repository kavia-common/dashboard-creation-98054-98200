#!/usr/bin/env bash
# CI-local flake8 shim: ensures a usable flake8 is available for the linter.
set -euo pipefail

# Prefer system flake8 if available
if command -v flake8 >/dev/null 2>&1; then
  exec "$(command -v flake8)" "$@"
fi

# Try BackendAPIService-local shim
if [ -x "../BackendAPIService/venv/bin/flake8" ]; then
  exec ../BackendAPIService/venv/bin/flake8 "$@"
fi

if [ -x "../BackendAPIService/flake8" ]; then
  exec ../BackendAPIService/flake8 "$@"
fi

# Attempt quick install in user site packages
if command -v python3 >/dev/null 2>&1; then
  python3 -m pip install --user flake8 >/dev/null 2>&1 || true
elif command -v python >/dev/null 2>&1; then
  python -m pip install --user flake8 >/dev/null 2>&1 || true
fi

if command -v flake8 >/dev/null 2>&1; then
  exec "$(command -v flake8)" "$@"
fi

echo "flake8 not found and could not be installed automatically." >&2
exit 127
