# BackendAPIService environment variables (example)
# Copy this file to .env and adjust as needed.

# Server
HOST=0.0.0.0
PORT=3001

# Database
# For local development, SQLite default is used if not provided.
# Example PostgreSQL URL:
DATABASE_URL=postgresql+psycopg2://user:password@db:5432/dashboard_db

# JWT configuration
# Replace with a strong secret in production.
JWT_SECRET_KEY=change-me-in-prod
JWT_EXPIRES_MINUTES=60

# Initial admin seed (optional; used only if database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!
