# BackendAPIService environment example
# Copy to .env and set appropriate secure values for production.

# Database connection (PostgreSQL recommended)
# Example: postgresql+psycopg2://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./app.db

# JWT configuration (REQUIRED in production)
JWT_SECRET_KEY=change-this-in-production
JWT_EXPIRES_MINUTES=60

# Optional: initial admin seeding on first startup (when no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# CORS (comma-separated lists)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Uvicorn runtime (used by src/run.py)
HOST=0.0.0.0
PORT=3001
UVICORN_RELOAD=false
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info
