# BackendAPIService environment variables
APP_NAME=Dashboard Backend API
APP_DESC=Secure REST API for authentication, users, reports, and charts
APP_VERSION=1.0.0

# Comma separated list of allowed origins for CORS (use * for all in development)
CORS_ORIGINS=*

# REQUIRED: Secret key for JWT signing. Use a long random string in production.
JWT_SECRET_KEY=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo admin seeding (optional). If DEMO_ADMIN_PASSWORD_HASH is empty a random hash is generated for "Admin@12345".
DEMO_ADMIN_EMAIL=admin@example.com
# bcrypt hash of a password (optional). Example below is hash of "Admin@12345"
#DEMO_ADMIN_PASSWORD_HASH=$2b$12$wQtM3E0z7.N2Bk0q6ZQeP.fQ8PZ8pHjHhQm2p7z2uF2nHc9XfJcVu

# Pagination defaults
DEFAULT_PAGE_SIZE=10
