# BackendAPIService environment example
# Copy to .env and set proper values for your environment.

# Database connection string
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/dashboard_db
# SQLite (dev only):
DATABASE_URL=sqlite:///./app.db

# JWT configuration
JWT_SECRET_KEY=insecure-dev-secret-change-me
JWT_EXPIRES_MINUTES=60

# App settings (optional)
APP_NAME=Dashboard Backend API
APP_DESCRIPTION=FastAPI backend providing JWT authentication, CRUD, and chart endpoints.
APP_VERSION=1.0.0

# Admin seeding on first startup (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!

# Server runtime
HOST=0.0.0.0
PORT=3001

# CORS (comma-separated origins; use * for all in dev)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
