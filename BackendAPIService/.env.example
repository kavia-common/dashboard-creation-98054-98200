# BackendAPIService environment variables
# IMPORTANT: Set a strong random string for production
JWT_SECRET_KEY=please-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App metadata
APP_NAME=Dashboard Backend API
APP_DESC=Secure REST API for authentication, users, reports, and charts
APP_VERSION=1.0.0

# CORS (comma-separated)
CORS_ORIGINS=*

# Demo seed admin
DEMO_ADMIN_EMAIL=admin@example.com
# Optional: bcrypt hash for Admin@12345 can be pre-set; otherwise generated at boot
# DEMO_ADMIN_PASSWORD_HASH=$2b$12$example...

# Pagination default
DEFAULT_PAGE_SIZE=10

# Service port (container listens on 3001; change only if orchestration expects different)
PORT=3001
