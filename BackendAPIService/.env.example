# Required environment variables for BackendAPIService

# PostgreSQL database URL example:
# postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/dashboard_db

# JWT secret values
JWT_SECRET_KEY=change-this-secret
JWT_EXPIRES_MINUTES=60

# Optional: initial admin seed on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!

# CORS settings (comma-separated origins or *). Defaults are permissive.
# CORS_ALLOW_ORIGINS=*
