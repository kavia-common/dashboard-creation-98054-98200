# BackendAPIService environment example
# Copy to .env and adjust values for your environment.

# Database
DATABASE_URL=sqlite:///./app.db

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_MINUTES=60

# Admin seeding (optional, dev convenience)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# CORS configuration
# Accepted formats for CORS_ALLOW_ORIGINS:
# - Single origin: http://localhost:3000
# - Comma-separated: http://localhost:3000,http://127.0.0.1:3000
# - JSON list string: ["http://localhost:3000","http://127.0.0.1:3000"]
# - Empty or unset defaults to * for development
CORS_ALLOW_ORIGINS=http://localhost:3000
# Methods and headers can be * or comma-separated list or JSON list
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
