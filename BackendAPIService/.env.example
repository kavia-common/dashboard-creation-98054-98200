# Example environment configuration for BackendAPIService (FastAPI)

# Database: Prefer PostgreSQL in production, e.g.:
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@relationaldb:5432/dashboard_db

# For local/dev the app defaults to sqlite:///./app.db when DATABASE_URL is not set.
# Uncomment to override:
# DATABASE_URL=sqlite:///./app.db

# JWT secret key (REQUIRED in production)
# JWT_SECRET_KEY=please-change-me-in-production

# Optional runtime settings
# HOST=0.0.0.0
# PORT=3001
# UVICORN_WORKERS=1
# UVICORN_LOG_LEVEL=info
# UVICORN_RELOAD=false

# Optional seeding for initial admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123!
