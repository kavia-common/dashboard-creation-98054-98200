# Copy to .env and update values for your environment.

# Database URL examples:
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/dashboard_db
# SQLite (for local quick start):
# DATABASE_URL=sqlite:///./local.db
DATABASE_URL=sqlite:///./local.db

# JWT settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_EXPIRES_MINUTES=60

# Optional admin seed on first startup (if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!

# Uvicorn optional overrides for local runs
# HOST=0.0.0.0
# PORT=8000
# UVICORN_RELOAD=true
# UVICORN_WORKERS=1
# UVICORN_LOG_LEVEL=info
