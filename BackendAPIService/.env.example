# BackendAPIService environment example

# Database connection URL
# For PostgreSQL (recommended):
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# Example (compose networking): postgresql+psycopg2://postgres:postgres@relationaldatabase:5432/dashboard_app_db
DATABASE_URL=sqlite:///./app.db

# JWT settings (REQUIRED in production)
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_MINUTES=60

# Optional admin bootstrap (used only when no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# CORS (comma separated or JSON array). Defaults are permissive for dev.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ASGI bind
HOST=0.0.0.0
PORT=3001

# Uvicorn controls
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=false

# Database readiness backoff (on startup)
DB_CONNECT_MAX_ATTEMPTS=20
DB_CONNECT_BASE_DELAY=0.5
DB_CONNECT_MAX_DELAY=5.0
